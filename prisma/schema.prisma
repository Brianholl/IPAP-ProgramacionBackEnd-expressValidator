generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(60)
  descripcion String?    @db.VarChar(255)
  productos   Producto[]

  @@map("categorias")
}

model Proveedor {
  id             Int        @id @default(autoincrement())
  nombre_empresa String     @db.VarChar(100)
  contacto       String     @db.VarChar(100)
  telefono       String     @db.VarChar(30)
  email          String     @db.VarChar(100)
  direccion      String     @db.VarChar(150)
  cuit           String     @unique @db.VarChar(20)
  productos      Producto[]

  @@map("proveedores")
}

model Producto {
  id           Int             @id @default(autoincrement())
  nombre       String          @db.VarChar(100)
  descripcion  String?         @db.Text
  precio       Decimal         @db.Decimal(10, 2)
  stock        Int             @default(0)
  id_categoria Int
  id_proveedor Int
  categoria    Categoria       @relation(fields: [id_categoria], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_productos_categoria")
  proveedor    Proveedor       @relation(fields: [id_proveedor], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_productos_proveedor")
  detalles     PedidoDetalle[]

  @@index([id_categoria])
  @@index([id_proveedor])
  @@map("productos")
}

model Empleado {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(50)
  apellido      String   @db.VarChar(50)
  dni           String   @unique @db.VarChar(20)
  cargo         String   @db.VarChar(50)
  email         String   @unique @db.VarChar(100)
  telefono      String   @db.VarChar(30)
  fecha_ingreso DateTime @db.Date
  pedidos       Pedido[]

  @@map("empleados")
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(100)
  cuit_dni  String   @unique @db.VarChar(20)
  telefono  String   @db.VarChar(30)
  email     String   @db.VarChar(100)
  direccion String   @db.VarChar(150)
  ciudad    String   @db.VarChar(60)
  pedidos   Pedido[]

  @@map("clientes")
}

model CompaniaEnvio {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique @db.VarChar(100)
  telefono String   @db.VarChar(30)
  email    String   @db.VarChar(100)
  pedidos  Pedido[]

  @@map("companias_envio")
}

enum EstadoPedido {
  Pendiente
  Enviado
  Entregado
  Cancelado
}

model Pedido {
  id                Int             @id @default(autoincrement())
  numero_factura    String          @unique @db.VarChar(25)
  fecha             DateTime        @default(now()) @db.DateTime(0)
  id_cliente        Int
  id_empleado       Int
  id_compania_envio Int
  estado            EstadoPedido    @default(Pendiente)
  total             Decimal         @default(0.00) @db.Decimal(10, 2)
  cliente           Cliente         @relation(fields: [id_cliente], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_pedidos_cliente")
  empleado          Empleado        @relation(fields: [id_empleado], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_pedidos_empleado")
  compania_envio    CompaniaEnvio   @relation(fields: [id_compania_envio], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_pedidos_compania")
  detalles          PedidoDetalle[]

  @@index([id_cliente])
  @@index([id_empleado])
  @@index([id_compania_envio])
  @@index([fecha])
  @@map("pedidos")
}

model PedidoDetalle {
  id              Int      @id @default(autoincrement())
  id_pedido       Int
  id_producto     Int
  cantidad        Int
  precio_unitario Decimal  @db.Decimal(10, 2)
  subtotal        Decimal  @db.Decimal(10, 2)
  pedido          Pedido   @relation(fields: [id_pedido], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_detalle_pedido")
  producto        Producto @relation(fields: [id_producto], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_detalle_producto")

  @@unique([id_pedido, id_producto])
  @@index([id_producto])
  @@map("pedidos_detalle")
}
