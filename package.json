{
  "name": "tp6-distribuidora-prisma",
  "version": "1.0.0",
  "description": "TP6 - TypeScript y ORM Prisma: API de la distribuidora - IPAP",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "start:dev": "tsx watch ./src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node ./dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "mysql"
  ],
  "author": "Brian Iván Hollweg, Yanina Elizabeth Ovejero",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "mariadb": "^3.5.4",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
